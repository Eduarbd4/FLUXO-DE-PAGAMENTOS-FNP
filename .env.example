# ---------- Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # secreta: só no servidor / Vercel

# ---------- Portal
APP_URL=https://portal-financeiro.vercel.app # endereço público do portal (sem / no final)
ALLOWED_EMAIL_DOMAINS=suaempresa.com.br      # quem pode entrar e abrir pedido por e-mail (separe por vírgula)
NOTIFICAR_EQUIPE=true                        # avisa por e-mail cada pessoa do financeiro quando o solicitante escreve
CRON_SECRET=troque-por-um-texto-longo-aleatorio

# ---------- Microsoft 365 (Entra ID > Registros de aplicativo)
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=xxxxx
MAILBOX_ADDRESS=financeiro@suaempresa.com.br # caixa compartilhada que envia e recebe
GRAPH_CLIENT_STATE=troque-por-outro-texto-aleatorio
